---
import AccountMenu from "../components/AccountMenu";
import "../styles/recipes.css";
import "../styles/forms.css";
import "../styles/profile.css";
import "../styles/communities.css";

const { title, nav = true } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — bodyworks</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="rb-page">
      {
        nav && (
          <header class="pf-topbar">
            <a href="/recipes" class="rb-logo">
              bodyworks
            </a>
            <nav class="rb-nav" aria-label="Main">
              <a href="/recipes">Recipes</a>
              <a href="/communities">Communities</a>
            </nav>
            <AccountMenu client:load />
          </header>
        )
      }
      <slot />
    </div>
  </body>
</html>
