---
import AccountMenu from "../components/AccountMenu";
import "../styles/recipes.css";
import "../styles/forms.css";
import "../styles/profile.css";
import "../styles/communities.css";
import "../styles/sunrise.css";

const { title, nav = true } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>try{var t=localStorage.getItem("bw-theme");if(t!=="light"&&t!=="dark"&&t!=="night")t=matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";var h=document.documentElement;h.dataset.theme=t==="night"?"dark":t;if(t==="night")h.dataset.palette="night";else delete h.dataset.palette}catch(e){document.documentElement.dataset.theme="light"}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — bodyworks</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="rb-page">
      {
        nav && (
          <header class="pf-topbar">
            <a href="/recipes" class="rb-logo">
              bodyworks
            </a>
            <nav class="rb-nav" aria-label="Main">
              <a href="/workouts">Workouts</a>
              <a href="/recipes">Recipes</a>
            </nav>
            <AccountMenu client:load />
          </header>
        )
      }
      <slot />
    </div>
  </body>
</html>
