---
export const prerender = false;
import CommunitiesBrowser from "../../components/communities/CommunitiesBrowser";
import { listMyCommunities, listPublicCommunities } from "../../db/communities";
import "../../styles/recipes.css";
import "../../styles/forms.css";
import "../../styles/communities.css";

const user = Astro.locals.user;
const [mine, publicList] = await Promise.all([user ? listMyCommunities(user.id) : [], listPublicCommunities()]);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Communities — bodyworks</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <CommunitiesBrowser mine={mine} publicList={publicList} signedIn={!!user} client:load />
  </body>
</html>
