---
export const prerender = false;
import AccountMenu from "../components/AccountMenu";
import "../styles/recipes.css";
import "../styles/forms.css";
import "../styles/landing.css";

// People who are signed in already know the site: skip straight to their recipes.
if (Astro.locals.user) return Astro.redirect("/recipes");

const sections = [
  {
    id: "workouts",
    title: "Workouts",
    lede: "Plan your training week on a calendar and tick sessions off as you go.",
    points: [
      "Schedule workouts by day and time",
      "Repeat a session on a weekly pattern",
      "Mark sessions as done",
      "Make your own icons for custom workouts",
    ],
    cta: "Open workouts",
    href: "/workouts",
    image: "/squat2.png",
    alt: "Anatomy illustration of the muscles working during a single-leg squat",
  },
  {
    id: "recipes",
    title: "Recipes",
    lede: "Keep the meals you cook, find ones you like, and plan the week around them.",
    points: [
      "Your own recipes, plus ones you save from other cooks",
      "Drag recipes into a weekly meal plan",
      "A cook log with photo, notes and a voice note each time you make a dish",
      "Communities to share recipes with",
    ],
    cta: "Open recipes",
    href: "/recipes",
    image: "/foodRecipes/landingPage_noBg.png",
    alt: "Illustrated high-protein meals",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>try{var t=localStorage.getItem("bw-theme");if(t!=="light"&&t!=="dark")t=matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";document.documentElement.dataset.theme=t}catch(e){document.documentElement.dataset.theme="light"}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Train, fuel, repeat — bodyworks</title>
    <meta name="description" content="Plan your workouts on a calendar, keep your recipes, and plan your meals for the week." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="rb-page lp">
      <header class="rb-topbar">
        <a href="/" class="rb-wordmark">bodyworks</a>
        <span class="lp-spacer"></span>
        <AccountMenu client:load />
      </header>

      <main class="lp-main">
        <section class="lp-hero">
          <h1>Train, fuel, repeat.</h1>
          <p>Plan your workouts, keep your recipes, and line up your meals for the week, all in one place.</p>
        </section>

        <section class="lp-cards" aria-label="What you can do here">
          {
            sections.map((s) => (
              <a class={`lp-card lp-card--${s.id}`} href={s.href}>
                <div class="lp-media">
                  <img src={s.image} alt={s.alt} loading="eager" />
                </div>
                <div class="lp-body">
                  <h2>{s.title}</h2>
                  <p class="lp-lede">{s.lede}</p>
                  <ul>
                    {s.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                  <span class="rb-btn rb-btn-solid lp-cta">{s.cta} →</span>
                </div>
              </a>
            ))
          }
        </section>
      </main>
    </div>
  </body>
</html>
