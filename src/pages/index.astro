---
export const prerender = false;
import AccountMenu from "../components/AccountMenu";
import LandingHero from "../components/landing/LandingHero";
import "../styles/recipes.css";
import "../styles/forms.css";
import "../styles/landing.css";
import "../styles/sunrise.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>try{var t=localStorage.getItem("bw-theme");if(t!=="light"&&t!=="dark")t=matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";document.documentElement.dataset.theme=t}catch(e){document.documentElement.dataset.theme="light"}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bodyworks — plan your workouts and your meals</title>
    <meta name="description" content="Plan your workouts, save recipes, and build a healthier routine with Bodyworks." />
  </head>
  <body>
    <div class="rb-page lp">
      <header class="lp-top">
        <a href="/" class="lp-wordmark" aria-label="Bodyworks home">bodyworks<span>.</span></a>
        <nav class="lp-nav" aria-label="Main">
          <a href="/workouts">Workouts</a>
          <a href="/recipes">Recipes</a>
        </nav>
        <AccountMenu client:load />
      </header>
      <main class="lp-main">
        <LandingHero client:load />
        <footer class="lp-footer">Move with purpose. Fuel your everyday.</footer>
      </main>
    </div>
  </body>
</html>
