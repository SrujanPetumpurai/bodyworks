---
export const prerender = false;
import { CalendarDays, NotebookPen, Repeat, UtensilsCrossed } from "lucide-react";
import AccountMenu from "../components/AccountMenu";
import "../styles/recipes.css";
import "../styles/forms.css";
import "../styles/landing.css";

// People who are signed in already know the site: skip straight to their recipes.
if (Astro.locals.user) return Astro.redirect("/recipes");

const panels = [
  { title: "Workouts", points: ["Schedule by day and time", "Repeat on a weekly pattern", "Mark sessions as done"] },
  { title: "Recipes", points: ["Your recipes, plus ones you save", "Drag them into a weekly meal plan", "Photos and voice notes each time you cook"] },
];
const badges = [
  { label: "Schedule", Icon: CalendarDays },
  { label: "Repeat", Icon: Repeat },
  { label: "Meal plan", Icon: UtensilsCrossed },
  { label: "Cook log", Icon: NotebookPen },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Train, fuel, repeat — bodyworks</title>
    <meta name="description" content="Plan your workouts on a calendar, keep your recipes, and plan your meals for the week." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="rb-page lp">   
      <div class="lp-background" aria-hidden="true">
        <div class="lp-background__half lp-background__half--kitchen"></div>
        <div class="lp-background__half lp-background__half--workout"></div>
        <div class="lp-background__overlay"></div>
      </div>
      <header class="lp-top">
        <a href="/" class="lp-wordmark">bodyworks</a>
        <AccountMenu showThemeToggle={false} client:load />
      </header>

      <main class="lp-stage">
        <section class="lp-visual" aria-hidden="false">
 <img class="lp-pan-img" src="/public/cooking_drawing.jpg" alt="Illustrated pan of high-protein food" />
        </section>

        <section class="lp-info">
          <h1>Train.<br />Fuel.<br />Repeat.</h1>
          <p class="lp-tag">Plan the week. Log the work.</p>

          <div class="lp-panels">
            {
              panels.map((p) => (
                <div class="lp-panel">
                  <h2>{p.title}</h2>
                  <ul>
                    {p.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>

          <ul class="lp-badges" aria-label="Features">
            {
              badges.map(({ label, Icon }) => (
                <li>
                  <Icon size={22} strokeWidth={1.6} aria-hidden="true" />
                  <span>{label}</span>
                </li>
              ))
            }
          </ul>

          <div class="lp-ctas">
            <a class="lp-cta lp-cta--main" href="/recipes">Open recipes <span aria-hidden="true">→</span></a>
            <a class="lp-cta lp-cta--alt" href="/workouts">Open workouts <span aria-hidden="true">→</span></a>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
