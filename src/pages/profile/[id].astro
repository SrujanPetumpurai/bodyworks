---
export const prerender = false;
import ProfileView from "../../components/profile/ProfileView";
import { getProfile, listRecipes } from "../../db/recipes";
import { listSavedSlugs } from "../../db/saved-recipes";
import "../../styles/recipes.css";
import "../../styles/profile.css";
import "../../styles/forms.css";

const { id } = Astro.params;
const profile = id ? await getProfile(id) : null;
if (!profile) return new Response("Profile not found", { status: 404 });

const viewer = Astro.locals.user;
const isOwner = viewer?.id === profile.id;

const [recipes, viewerSavedSlugs] = await Promise.all([
  listRecipes({ authorId: profile.id, viewerId: viewer?.id }),
  viewer ? listSavedSlugs(viewer.id) : Promise.resolve([] as string[]),
]);

// the "Saved" tab is private: only the profile's owner gets it
const savedSet = new Set(viewerSavedSlugs);
const savedRecipes =
  isOwner && savedSet.size > 0 ? (await listRecipes({ viewerId: viewer!.id })).filter((r) => savedSet.has(r.slug)) : [];

const wantedTab = Astro.url.searchParams.get("tab");
const tab = wantedTab === "recipes" ? "recipes" : wantedTab === "saved" && isOwner ? "saved" : "home";
const sort = Astro.url.searchParams.get("sort") === "top" ? "top" : "recent";

const data = {
  id: profile.id,
  name: profile.name,
  image: profile.image,
  banner: profile.banner,
  joinedAt: profile.joinedAt.toISOString(),
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>try{var t=localStorage.getItem("bw-theme");if(t!=="light"&&t!=="dark")t=matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";document.documentElement.dataset.theme=t}catch(e){document.documentElement.dataset.theme="light"}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} — bodyworks</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <ProfileView
      profile={data}
      isOwner={isOwner}
      viewerId={viewer?.id ?? null}
      recipes={recipes}
      savedRecipes={savedRecipes}
      savedSlugs={viewerSavedSlugs}
      initialTab={tab}
      initialSort={sort}
      client:load
    />
  </body>
</html>
