---
export const prerender = false;
import AccountMenu from "../components/AccountMenu";
import "../styles/recipes.css";
import "../styles/forms.css";
// Page is hidden for now: send everyone home. Delete this line (and set prerender back to true) to restore it.
return Astro.redirect("/");

const bodyTypes = [
  { id: "male", label: "Male" },
  { id: "female", label: "Female" },
  { id: "pregnant", label: "Pregnant Women" },
];

const ageGroups = [
  { id: "child", label: "4–8" },
  { id: "teenager", label: "9–18" },
  { id: "adult", label: "19–50" },
  { id: "older_adult", label: "51–70" },
  { id: "elderly", label: "70+" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Daily Requirements — bodyworks</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="dr rb-page">
    <header class="rb-topbar">
      <a href="/" class="rb-wordmark">BODYWORKS<span>.</span></a>
      <nav class="rb-nav" aria-label="Main">
        <a href="/workouts">Workouts</a>
        <a href="/daily-requirements" aria-current="page">Daily needs</a>
        <a href="/recipes">Recipes</a>
      </nav>
      <AccountMenu client:load />
    </header>
    <main class="dr-main">
      <header class="intro">
        <h1>Daily Requirements</h1>
        <p>Set your body type and age to see personalized nutrition and rest targets.</p>
      </header>
      <section class="profile-card">
        <div class="selectors">
          <div class="field">
            <span class="field-label">Body Type:</span>
            <div class="dropdown" data-dropdown="bodyType">
              <button class="pill" type="button">Male</button>
              <ul class="menu" hidden>
                {bodyTypes.map((b) => (
                  <li><button type="button" data-value={b.id}>{b.label}</button></li>
                ))}
              </ul>
            </div>
          </div>
          <div class="field">
            <span class="field-label">Age:</span>
            <div class="dropdown" data-dropdown="age">
              <button class="pill" type="button">9–18</button>
              <ul class="menu" hidden>
                {ageGroups.map((a) => (
                  <li><button type="button" data-value={a.id}>{a.label}</button></li>
                ))}
              </ul>
            </div>
          </div>

          <button class="advanced-toggle" id="advanced-toggle" type="button">+ Add height &amp; weight</button>
          <div class="advanced-panel" id="advanced-panel" hidden>
            <label class="mini-field">
              <span>Height (cm)</span>
              <input type="number" id="height-input" placeholder="170" />
            </label>
            <label class="mini-field">
              <span>Weight (kg)</span>
              <input type="number" id="weight-input" placeholder="65" />
            </label>
          </div>
        </div>

        <div class="profile-icon" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="34" height="34">
            <circle cx="32" cy="22" r="14" fill="#1a1310" />
            <path d="M8 58c0-14 10.7-22 24-22s24 8 24 22" fill="#1a1310" />
          </svg>
        </div>
      </section>

      <section class="table-card">
        <div class="table-header">
          <h2>Your Daily Targets</h2>
          <div class="search-wrap">
            <input type="text" id="nutrient-search" placeholder="Search nutrients…" />
          </div>
        </div>
        <div class="list-head" aria-hidden="true">
          <span>Nutrient</span>
          <span class="lh-value">Daily target</span>
          <span class="lh-stars">Importance</span>
          <span></span>
        </div>
        <ul class="nutrient-list" id="nutrient-list">
          <li class="loading-row">Loading…</li>
        </ul>
        <p class="no-results" id="no-results" hidden>No nutrients match your search.</p>
      </section>
    </main>
    </div>

    <div class="dr modal-overlay" id="sources-modal" hidden>
      <div class="modal-box">
        <button type="button" class="modal-close" id="modal-close" aria-label="Close">×</button>
        <h3 id="modal-title"></h3>
        <ul class="modal-source-list" id="modal-source-list"></ul>
      </div>
    </div>

    <script>
      interface ResolvedRequirement {
        valueType: "fixed" | "range" | "coefficient_per_kg" | "coefficient_per_cm";
        min: number;
        max: number | null;
        unit: string;
        resolved: number | null;
      }

      interface FoodSource {
        sourceType: "food";
        food: { slug: string; name: string };
        foodAmount: number;
        foodUnit: string;
        nutrientAmount: number;
        nutrientUnit: string;
      }

      interface ReferenceSource {
        sourceType: "reference";
        name: string;
        description: string | null;
        url: string | null;
      }

      type NutrientSource = FoodSource | ReferenceSource;

      interface Nutrient {
        slug: string;
        name: string;
        unit: string;
        importance: number;
        requiresBodyMetrics: boolean;
        usesWeight: boolean;
        usesHeight: boolean;
        ready: boolean;
        points: string[];
        sources: NutrientSource[];
        dailyIntake: ResolvedRequirement | null;
        bodyStore: ResolvedRequirement | null;
      }

      interface AppState {
        bodyType: string;
        ageBracket: string;
        weightKg: number | undefined;
        heightCm: number | undefined;
      }

      const state: AppState = {
        bodyType: "male",
        ageBracket: "teenager",
        weightKg: undefined,
        heightCm: undefined,
      };

      // --- custom dropdowns (no native select, no arrow) ---
      document.querySelectorAll<HTMLDivElement>(".dropdown").forEach((dd) => {
        const key = dd.getAttribute("data-dropdown"); // "bodyType" | "age"
        const pill = dd.querySelector<HTMLButtonElement>(".pill");
        const menu = dd.querySelector<HTMLUListElement>(".menu");

        if (!pill || !menu) return;

        pill.addEventListener("click", (e) => {
          e.stopPropagation();
          document.querySelectorAll<HTMLUListElement>(".menu").forEach((m) => {
            if (m !== menu) m.hidden = true;
          });
          menu.hidden = !menu.hidden;
        });

        menu.querySelectorAll<HTMLButtonElement>("button").forEach((opt) => {
          opt.addEventListener("click", (e) => {
            e.stopPropagation();
            const value = opt.dataset.value;
            if (!value) return;
            if (key === "bodyType") state.bodyType = value;
            if (key === "age") state.ageBracket = value;
            pill.textContent = opt.textContent;
            menu.hidden = true;
            fetchAndRender();
          });
        });
      });

      document.addEventListener("click", () => {
        document.querySelectorAll<HTMLUListElement>(".menu").forEach((m) => (m.hidden = true));
      });

      // --- advanced height/weight toggle ---
      const advToggle = document.getElementById("advanced-toggle") as HTMLButtonElement | null;
      const advPanel = document.getElementById("advanced-panel") as HTMLDivElement | null;

      if (advToggle && advPanel) {
        advToggle.addEventListener("click", () => {
          const isHidden = advPanel.hidden;
          advPanel.hidden = !isHidden;
          advToggle.textContent = isHidden ? "− Hide height & weight" : "+ Add height & weight";
        });
      }

      const heightInput = document.getElementById("height-input") as HTMLInputElement | null;
      const weightInput = document.getElementById("weight-input") as HTMLInputElement | null;

      let debounceTimer: ReturnType<typeof setTimeout>;
      function onMetricInput() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          const h = parseFloat(heightInput?.value ?? "");
          const w = parseFloat(weightInput?.value ?? "");
          state.heightCm = Number.isFinite(h) ? h : undefined;
          state.weightKg = Number.isFinite(w) ? w : undefined;
          fetchAndRender();
        }, 400);
      }
      heightInput?.addEventListener("input", onMetricInput);
      weightInput?.addEventListener("input", onMetricInput);

      // --- fetch + render ---
      const list = document.getElementById("nutrient-list") as HTMLUListElement | null;
      const noResults = document.getElementById("no-results") as HTMLParagraphElement | null;
      const searchInput = document.getElementById("nutrient-search") as HTMLInputElement | null;

      async function fetchAndRender(): Promise<void> {
        if (!list) return;

        const params = new URLSearchParams({
          bodyType: state.bodyType,
          ageBracket: state.ageBracket,
        });
        if (state.weightKg !== undefined) params.set("weightKg", String(state.weightKg));
        if (state.heightCm !== undefined) params.set("heightCm", String(state.heightCm));

        list.innerHTML = `<li class="loading-row">Loading…</li>`;

        try {
          const res = await fetch(`/api/nutrients?${params.toString()}`);
          if (!res.ok) {
            list.innerHTML = `<li class="loading-row">Couldn't load nutrients — try again.</li>`;
            return;
          }
          const nutrients: Nutrient[] = await res.json();
          renderList(nutrients.filter((n) => n.ready));
          applySearchFilter();
        } catch (err) {
          list.innerHTML = `<li class="loading-row">Couldn't load nutrients — try again.</li>`;
        }
      }

      function formatReq(req: ResolvedRequirement | null | undefined): string {
        if (!req || req.resolved == null) return "—";
        if (req.valueType === "range" && req.max != null) {
          const min = Number.isInteger(req.min) ? req.min : req.min.toFixed(1);
          const max = Number.isInteger(req.max) ? req.max : req.max.toFixed(1);
          return `${min}–${max} ${req.unit}`;
        }
        if (req.resolved == null) return "—";
        const value = Number.isInteger(req.resolved) ? req.resolved : req.resolved.toFixed(1);
        return `${value} ${req.unit}`;
      }

      const starIcon = (on: boolean): string =>
        `<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="${on ? "#c6f432" : "#3a443e"}">
          <path d="M12 2.5l2.9 6.3 6.9.7-5.2 4.7 1.5 6.8L12 17.6 5.9 21l1.5-6.8-5.2-4.7 6.9-.7z" />
        </svg>`;

      function renderList(nutrients: Nutrient[]): void {
        if (!list) return;
        list.innerHTML = "";

        if (nutrients.length === 0) {
          list.innerHTML = `<li class="loading-row">No data for this selection yet.</li>`;
          return;
        }

        nutrients.forEach((n) => {
          const li = document.createElement("li");
          li.className = "nutrient-row";
          li.dataset.name = n.name.toLowerCase();

          const bodyStoreLine = n.bodyStore
            ? `<p class="n-bodystore"><strong>Body should contain:</strong> ${formatReq(n.bodyStore)}</p>`
            : "";

          const pointsHtml = n.points.map((p) => `<li>${p}</li>`).join("");

          li.innerHTML = `
            <button class="row-main" type="button" data-toggle>
              <span class="n-name">${n.name}</span>
              <span class="n-value">${formatReq(n.dailyIntake)}</span>
              <span class="n-stars"></span>
              <span class="n-arrow">›</span>
            </button>
            <div class="row-info" hidden>
              ${bodyStoreLine}
              <ul class="n-points">${pointsHtml}</ul>
              ${n.sources.length ? `<button type="button" class="sources-btn">Sources</button>` : ""}
            </div>
          `;

          const starsEl = li.querySelector<HTMLSpanElement>(".n-stars");
          if (starsEl) {
            starsEl.innerHTML = starIcon(true).repeat(n.importance) + starIcon(false).repeat(5 - n.importance);
            starsEl.setAttribute("aria-label", `${n.importance} out of 5 importance`);
          }

          const toggleBtn = li.querySelector<HTMLButtonElement>("[data-toggle]");
          const info = li.querySelector<HTMLDivElement>(".row-info");
          if (toggleBtn && info) {
            toggleBtn.addEventListener("click", () => {
              const isOpen = !info.hidden;
              info.hidden = isOpen;
              li.classList.toggle("open", !isOpen);
            });
          }

          const sourcesBtn = li.querySelector<HTMLButtonElement>(".sources-btn");
          sourcesBtn?.addEventListener("click", (e) => {
            e.stopPropagation();
            openSourcesModal(n);
          });

          list.appendChild(li);
        });
      }

      // --- sources modal ---
      const sourcesModal = document.getElementById("sources-modal") as HTMLDivElement | null;
      const modalTitle = document.getElementById("modal-title") as HTMLHeadingElement | null;
      const modalList = document.getElementById("modal-source-list") as HTMLUListElement | null;
      const modalCloseBtn = document.getElementById("modal-close") as HTMLButtonElement | null;

      function openSourcesModal(nutrient: Nutrient): void {
        if (!sourcesModal || !modalTitle || !modalList) return;

        modalTitle.textContent = `${nutrient.name} Sources`;
        modalList.innerHTML = nutrient.sources
          .map((s) => {
            if (s.sourceType === "food") {
              return `
                <li class="modal-source-row">
                  <div class="modal-source-info">
                    <strong>${s.food.name}</strong>
                    <span class="modal-source-qty">${s.foodAmount}${s.foodUnit} → ${s.nutrientAmount}${s.nutrientUnit}</span>
                  </div>
                  <button type="button" class="recipes-btn" disabled title="Recipes page coming soon">Recipes</button>
                </li>
              `;
            }
            return `
              <li class="modal-source-row">
                <div class="modal-source-info">
                  <strong>${s.name}</strong>
                  ${s.description ? `<span class="modal-source-desc">${s.description}</span>` : ""}
                </div>
              </li>
            `;
          })
          .join("");
        sourcesModal.hidden = false;
      }

      function closeSourcesModal(): void {
        if (sourcesModal) sourcesModal.hidden = true;
      }

      modalCloseBtn?.addEventListener("click", closeSourcesModal);
      sourcesModal?.addEventListener("click", (e) => {
        if (e.target === sourcesModal) closeSourcesModal();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && sourcesModal && !sourcesModal.hidden) closeSourcesModal();
      });

      function applySearchFilter(): void {
        if (!list || !searchInput || !noResults) return;
        const q = searchInput.value.trim().toLowerCase();
        let visibleCount = 0;
        list.querySelectorAll<HTMLLIElement>(".nutrient-row").forEach((row) => {
          const match = (row.dataset.name ?? "").includes(q);
          row.hidden = !match;
          if (match) visibleCount++;
        });
        noResults.hidden = visibleCount !== 0 || list.querySelector(".loading-row") !== null;
      }

      searchInput?.addEventListener("input", applySearchFilter);

      fetchAndRender();
        </script>

    <style is:global>
      /* The nutrient rows are built in JS, so these rules must be global
         (Astro's scoped styles never reach elements created at runtime). */
      .dr-main { max-width: 760px; margin: 0 auto; padding: 2.4rem 1.5rem 5rem; box-sizing: border-box; }

      .dr .intro { margin: 0 0 1.5rem; }
      .dr .intro h1 { font-size: 3.6rem; margin: 0; line-height: 0.95; }
      .dr .intro p { margin: 0.5rem 0 0; color: var(--sub); font-size: 1.05rem; }

      .dr .profile-card, .dr .table-card {
        background: var(--paper); border: 1px solid var(--edge); border-radius: 14px; padding: 1.4rem 1.5rem; margin: 0 0 1.5rem;
      }
      .dr .profile-card { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem; }

      .dr .selectors { display: flex; flex-direction: column; gap: 0.8rem; }
      .dr .field { display: flex; align-items: center; gap: 0.8rem; }
      .dr .field-label { min-width: 96px; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sub); }

      .dr .dropdown { position: relative; }
      .dr .pill {
        font: 600 0.95rem var(--font-body); color: var(--ink); background: var(--raise);
        border: 1px solid var(--rule); border-radius: 999px; padding: 0.4rem 1.1rem; cursor: pointer;
      }
      .dr .pill:hover { border-color: var(--sub); }
      .dr .pill::after { content: "▾"; margin-left: 0.5rem; color: var(--cta); font-size: 0.8rem; }

      .dr .menu {
        position: absolute; top: calc(100% + 6px); left: 0; z-index: 10; min-width: 160px; margin: 0; padding: 0.35rem;
        list-style: none; background: var(--paper); border: 1px solid var(--rule); border-radius: 10px;
        box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.8);
      }
      .dr .menu[hidden] { display: none; }
      .dr .menu button {
        width: 100%; text-align: left; border: none; background: transparent; color: var(--ink); cursor: pointer;
        font: 600 0.95rem var(--font-body); padding: 0.5rem 0.65rem; border-radius: 6px;
      }
      .dr .menu button:hover { background: var(--raise); }

      .dr .advanced-toggle {
        align-self: flex-start; border: none; background: none; cursor: pointer; padding: 0.2rem 0;
        color: var(--cta); font: 600 0.9rem var(--font-body);
      }
      .dr .advanced-toggle:hover { text-decoration: underline; }
      .dr .advanced-panel { display: flex; gap: 1rem; margin-top: 0.2rem; }
      .dr .advanced-panel[hidden] { display: none; }
      .dr .mini-field { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--sub); }
      .dr .mini-field input {
        width: 100px; font: 500 1rem var(--font-body); color: var(--ink); background: var(--bg);
        border: 1px solid var(--rule); border-radius: 8px; padding: 0.45rem 0.6rem; box-sizing: border-box;
      }

      /* the square: kept, now lime */
      .dr .profile-icon {
        flex-shrink: 0; width: 56px; height: 56px; border-radius: 12px; background: var(--cta);
        display: flex; align-items: center; justify-content: center;
      }
      .dr .profile-icon svg circle, .dr .profile-icon svg path { fill: #0f1210; }

      .dr .table-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
      .dr .table-header h2 { font-size: 2rem; margin: 0; line-height: 1; }
      .dr .search-wrap input {
        width: 200px; font: 500 0.95rem var(--font-body); color: var(--ink); background: var(--bg);
        border: 1px solid var(--rule); border-radius: 10px; padding: 0.55rem 0.9rem; box-sizing: border-box;
      }
      .dr .search-wrap input::placeholder { color: var(--sub); }
      .dr .search-wrap input:focus { outline: 3px solid var(--cta); outline-offset: 1px; }

      /* shared grid so the header labels line up with every row */
      .dr .list-head, .dr .row-main { display: grid; grid-template-columns: minmax(0, 1fr) 130px 130px 1.25rem; align-items: center; gap: 0.6rem; }
      .dr .list-head { padding: 0 1rem 0.5rem; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--sub); }
      .dr .lh-value { text-align: center; }
      .dr .lh-stars { text-align: right; }

      .dr .nutrient-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
      .dr .loading-row { padding: 0.9rem 1rem; color: var(--sub); font-size: 0.95rem; }

      .dr .nutrient-row { border: 1px solid var(--edge); border-radius: 10px; overflow: hidden; background: var(--bg); }
      .dr .nutrient-row[hidden] { display: none; }
      .dr .nutrient-row.open { border-color: var(--rule); }
      .dr .row-main {
        width: 100%; border: none; background: transparent; padding: 0.85rem 1rem; cursor: pointer;
        font-family: var(--font-body); color: var(--ink); text-align: left;
      }
      .dr .row-main:hover { background: var(--raise); }
      .dr .n-name { font-weight: 600; font-size: 1.05rem; }
      .dr .n-value { font-weight: 700; font-size: 1.05rem; text-align: center; color: var(--cta); }
      .dr .n-stars { display: flex; justify-content: flex-end; gap: 2px; }
      .dr .n-arrow { font-size: 1.3rem; color: var(--sub); transition: transform 0.15s ease; justify-self: end; }
      .dr .nutrient-row.open .n-arrow { transform: rotate(90deg); }

      .dr .row-info { padding: 0.7rem 1rem 1rem; border-top: 1px solid var(--edge); }
      .dr .row-info[hidden] { display: none; }
      .dr .row-info p { margin: 0 0 0.5rem; font-size: 0.95rem; line-height: 1.5; color: var(--sub); }
      .dr .row-info .n-bodystore { color: var(--ink); font-weight: 600; }
      .dr .row-info ul { margin: 0 0 0.8rem; padding-left: 1.1rem; }
      .dr .row-info li { font-size: 0.95rem; line-height: 1.5; color: var(--sub); margin-bottom: 0.25rem; }

      .dr .sources-btn, .dr .recipes-btn {
        font: 600 0.9rem var(--font-body); color: var(--ink); background: transparent;
        border: 1px solid var(--rule); border-radius: 8px; padding: 0.4rem 0.9rem; cursor: pointer;
      }
      .dr .sources-btn:hover, .dr .recipes-btn:not(:disabled):hover { background: var(--raise); border-color: var(--sub); }
      .dr .recipes-btn { flex-shrink: 0; }
      .dr .recipes-btn:disabled { cursor: not-allowed; opacity: 0.5; }

      .dr .no-results { text-align: center; color: var(--sub); margin: 1rem 0 0; }
      .dr .no-results[hidden] { display: none; }

      /* sources modal */
      .modal-overlay.dr {
        position: fixed; inset: 0; z-index: 100; padding: 1.5rem; background: rgba(5, 7, 6, 0.78);
        align-items: center; justify-content: center; font-family: var(--font-body); color: var(--ink);
      }
      .modal-overlay.dr[hidden] { display: none; }
      .modal-overlay.dr:not([hidden]) { display: flex; }
      .dr .modal-box {
        position: relative; width: 100%; max-width: 460px; max-height: 80vh; overflow-y: auto; box-sizing: border-box;
        background: var(--paper); border: 1px solid var(--rule); border-radius: 14px; padding: 1.5rem;
        box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8);
      }
      .dr .modal-close { position: absolute; top: 0.6rem; right: 0.8rem; width: 36px; height: 36px; border: none; background: none; border-radius: 8px; font-size: 1.6rem; line-height: 1; color: var(--sub); cursor: pointer; }
      .dr .modal-close:hover { color: var(--ink); background: var(--raise); }
      .dr .modal-box h3 { font-size: 1.9rem; margin: 0 0 1rem; line-height: 1; padding-right: 2rem; }
      .dr .modal-source-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; }
      .dr .modal-source-row { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; border: 1px solid var(--edge); border-radius: 10px; padding: 0.7rem 0.9rem; background: var(--bg); }
      .dr .modal-source-info { display: flex; flex-direction: column; gap: 0.15rem; }
      .dr .modal-source-info strong { font-size: 1rem; }
      .dr .modal-source-qty { font-size: 0.9rem; color: var(--cta); font-weight: 600; }
      .dr .modal-source-desc { font-size: 0.9rem; color: var(--sub); }

      @media (max-width: 600px) {
        .dr-main { padding: 1.6rem 1rem 4rem; }
        .dr .intro h1 { font-size: 2.8rem; }
        .dr .profile-card, .dr .table-card { padding: 1.1rem; }
        .dr .list-head { display: none; }
        .dr .row-main { grid-template-columns: minmax(0, 1fr) auto 1.25rem; row-gap: 0.3rem; }
        .dr .n-stars { grid-column: 1 / -1; grid-row: 2; justify-content: flex-start; }
        .dr .search-wrap input { width: 100%; }
        .dr .search-wrap { flex: 1 1 100%; }
      }
    </style>
  </body>
</html>