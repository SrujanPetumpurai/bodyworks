---
export const prerender = false;
import RecipesBrowser from "../components/recipes/RecipesBrowser";
import { listFoods, listRecipes } from "../db/recipes";
import "../styles/recipes.css";
import "../styles/forms.css";

const [foods, recipes] = await Promise.all([listFoods(), listRecipes({ viewerId: Astro.locals.user?.id })]);
const foodOptions = foods.map((f) => ({ slug: f.slug, name: f.name }));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Recipes — bodyworks</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <RecipesBrowser foods={foodOptions} recipes={recipes} signedIn={!!Astro.locals.user} client:load />
  </body>
</html>