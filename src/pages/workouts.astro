---
export const prerender = false;
import WorkoutCalendar from "../components/workouts/WorkoutCalendar";
import "../styles/recipes.css";
import "../styles/forms.css";
import "../styles/workouts.css";

const signedIn = !!Astro.locals.user;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>try{var t=localStorage.getItem("bw-theme");if(t!=="light"&&t!=="dark")t=matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light";document.documentElement.dataset.theme=t}catch(e){document.documentElement.dataset.theme="light"}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Workouts — bodyworks</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <WorkoutCalendar signedIn={signedIn} client:load />
  </body>
</html>
