---
export const prerender = false;
import WorkoutCalendar from "../components/workouts/WorkoutCalendar";
import "../styles/recipes.css";
import "../styles/forms.css";
import "../styles/workouts.css";

const signedIn = !!Astro.locals.user;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Workouts — bodyworks</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <WorkoutCalendar signedIn={signedIn} client:load />
  </body>
</html>
