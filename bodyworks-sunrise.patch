+.sr-banner { max-width: 1180px; margin: 1.1rem auto 0; padding: 0 2rem; box-sizing: border-box; }
+.sr-banner-in { position: relative; overflow: hidden; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;
+  padding: 1.8rem 2.2rem; border: 2px solid #2b1411; border-radius: 32px; background: var(--sun); color: #2b1411; box-shadow: 6px 6px 0 #2b1411; }
+.sr-banner-in::after { content: ""; position: absolute; right: -50px; top: -70px; width: 220px; height: 220px; border-radius: 50%; background: var(--blush); opacity: 0.85; }
+.sr-banner-in > * { position: relative; z-index: 1; }
+.sr-banner h2 { margin: 0; font-size: clamp(1.9rem, 4vw, 3rem); line-height: 1; color: #2b1411; }
+.sr-banner p { margin: 0.45rem 0 0; font-weight: 600; }
+.sr-banner-btn { padding: 0.8rem 1.4rem; border-radius: 999px; background: #2b1411; color: #fff6df !important; font-weight: 800; text-decoration: none; }
+.sr-banner-btn:hover { background: #7a1d24; }
+@media (max-width: 760px) { .sr-banner { padding: 0 1rem; } .sr-banner-in { padding: 1.3rem; } }
