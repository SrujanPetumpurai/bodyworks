+/* Landing page layout. Colours and fonts come from the tokens in sunrise.css. */
+.rb-page.lp { min-height: 100svh; overflow-x: clip; }
+.lp-top { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; max-width: 1240px; margin: 0 auto; padding: 1rem 2rem; box-sizing: border-box; }
+.rb-page .lp-wordmark { font: 800 1.9rem/1 var(--font-head); letter-spacing: -0.03em; color: var(--ink); text-decoration: none; }
+.rb-page .lp-wordmark span { color: var(--cta); }
+.lp-nav { display: flex; gap: 0.3rem; flex: 1; }
+.rb-page .lp-nav a { padding: 0.5rem 0.9rem; font-weight: 700; color: var(--sub); text-decoration: none; }
+.rb-page .lp-nav a:hover { color: var(--ink); }
+
+.lp-main { max-width: 1240px; margin: 0 auto; padding: 0 2rem 2rem; box-sizing: border-box; }
+.lp-hero { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 2.5rem; align-items: center; padding: 1.5rem 0 3rem; }
+.lp-eyebrow { display: inline-block; margin: 0 0 1rem; padding: 0.35rem 0.9rem; border: 2px solid var(--line); border-radius: 999px; background: var(--paper); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
+.rb-page .lp-copy h1 { margin: 0; font-size: clamp(3.2rem, 7.4vw, 6.6rem); line-height: 0.92; letter-spacing: -0.035em; }
+.rb-page .lp-copy h1 em { font-style: normal; color: var(--cta); }
+.lp-sub { max-width: 30rem; margin: 1.2rem 0 1.6rem; font-size: 1.15rem; color: var(--sub); font-weight: 500; }
+
+.lp-switch { display: inline-flex; padding: 4px; border: 2px solid var(--line); border-radius: 999px; background: var(--paper); box-shadow: 4px 4px 0 var(--line); }
+.lp-switch button { min-height: 46px; padding: 0 1.6rem; border: 0; border-radius: 999px; background: transparent; color: var(--ink); font: 800 1rem var(--font-body); cursor: pointer; transition: background 0.15s; }
+.lp-switch button[aria-pressed="true"] { background: var(--cta); color: var(--on-cta); }
+.lp-cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem; margin-top: 1.6rem; }
+.rb-page a.lp-cta { padding: 1rem 1.7rem; border: 2px solid var(--line); border-radius: 16px; background: var(--sun); color: #2b1411; font-weight: 800; text-decoration: none; box-shadow: 4px 4px 0 var(--line); transition: transform 0.15s, box-shadow 0.15s; }
+.rb-page a.lp-cta:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--line); }
+.rb-page a.lp-ghost { color: var(--ink); font-weight: 700; }
+
+.lp-art { position: relative; aspect-ratio: 1; max-width: 520px; width: 100%; justify-self: center; }
+.lp-blob { position: absolute; inset: 4% -4% -4% 6%; border-radius: 50%; background: var(--blush); }
+.lp-photo { position: absolute; inset: 0 8% 8% 0; border: 3px solid var(--line); border-radius: 50%; background-size: cover; background-position: center; box-shadow: 8px 8px 0 var(--line); }
+.lp-sticker { position: absolute; right: 0; bottom: 2%; width: min(300px, 70%); padding: 1rem 1.1rem; border: 2px solid var(--line); border-radius: 22px; background: var(--paper); box-shadow: 5px 5px 0 var(--line); }
+.lp-sticker b { display: block; margin-bottom: 0.5rem; color: var(--cta); font-size: 0.9rem; }
+.lp-sticker div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.35rem 0; border-top: 1px dashed var(--rule); font-size: 0.9rem; font-weight: 600; }
+.lp-sticker div span:last-child { color: var(--sub); }
+
+.lp-week h2, .lp-features + .x { font-size: 1.6rem; margin: 0 0 1rem; }
+.lp-week-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.75rem; }
+.lp-day { display: flex; flex-direction: column; justify-content: space-between; min-height: 112px; padding: 0.9rem; border: 2px solid var(--line); border-radius: 20px; background: var(--paper); }
+.lp-day small { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sub); }
+.lp-day strong { font: 800 1.2rem/1.1 var(--font-head); }
+.lp-day.on { background: var(--cta); color: var(--on-cta); box-shadow: 4px 4px 0 var(--line); }
+.lp-day.on small { color: var(--on-cta); opacity: 0.85; }
+
+.lp-features { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 2.5rem; }
+.lp-feature { padding: 1.5rem; border: 2px solid var(--line); border-radius: 28px; box-shadow: 5px 5px 0 var(--line); background: var(--paper); }
+.lp-feature[data-n="1"] { background: var(--sun); color: #2b1411; }
+.lp-feature[data-n="2"] { background: var(--blush); color: #2b1411; }
+.lp-feature span { font: 800 0.8rem var(--font-body); letter-spacing: 0.14em; }
+.lp-feature h3 { margin: 0.5rem 0 0.4rem; font-size: 1.4rem; }
+.lp-feature p { margin: 0; font-weight: 500; }
+.lp-feature[data-n="3"] p { color: var(--sub); }
+.lp-footer { margin-top: 2.5rem; text-align: center; font-weight: 700; color: var(--sub); }
+
+@media (max-width: 860px) {
+  .lp-hero { grid-template-columns: 1fr; }
+  .lp-week-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+  .lp-features { grid-template-columns: 1fr; }
+  .lp-top, .lp-main { padding-left: 1rem; padding-right: 1rem; }
+}
+@media (prefers-reduced-motion: reduce) { * { transition-duration: 0.01ms !important; } }
